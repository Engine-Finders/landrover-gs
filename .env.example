# Copy to .env.local and fill in. Values are in the Vercel project settings.

# Mail relay (lead emails)
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_TO_ADDRESS=
MAIL_CC_ADDRESS=

# CRM (Supabase)
SUPABASE_WEBHOOK_URL=
SUPABASE_ANON_KEY=
SUPABASE_REST_URL=

# Plate look-up (server only, never NEXT_PUBLIC_)
VRM_API_KEY=

# /leads admin login
LEADS_ADMIN_PASSWORD=

# Blog / CMS
CMS_API_URL=
CMS_SITE_SLUG=
CMS_REVALIDATION_SECRET=

# Optional: canonical domain (defaults to the live domain)
NEXT_PUBLIC_SITE_URL=
